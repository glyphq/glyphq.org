---
import { attributes } from "../data/site";
import ButtonLink from "./button-link.astro";
import PatternWaves from "./pattern-waves";
import Reveal from "./reveal.astro";
---

<section class="relative overflow-hidden border-b border-line bg-accent text-white">
  <div class="absolute inset-0 opacity-55">
    <PatternWaves
      client:only="react"
      preset="lines"
      color="#93c5fd"
      backgroundColor="#2563eb"
      fade="edges"
      speed={0}
      intro={false}
    />
  </div>
  <Reveal duration="cinematic" class="relative z-10 px-4 py-20 text-center md:px-8 md:py-28">
    <h2 class="mx-auto max-w-3xl text-4xl leading-[1.05] tracking-[-0.025em] md:text-[56px]">
      Ready to try Glyph?
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-white/90 md:text-[19px] md:leading-[1.45]">
      Download the desktop wallet, or explore the network first.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <ButtonLink href="/download" variant="light" icon="glyph">Download Glyph</ButtonLink>
      <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="solar:global-linear">
        Open Explorer
      </ButtonLink>
    </div>
  </Reveal>
  <div class="relative z-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 border-t border-white/15 px-4 py-3 text-center font-mono text-[11px] uppercase tracking-[0.12em] text-white/80">
    {attributes.map((attribute) => <span>{attribute}</span>)}
  </div>
</section>
