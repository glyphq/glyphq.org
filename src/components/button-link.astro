---
import type { IconName } from "../lib/icons";
import UiIcon from "./ui-icon.astro";

interface Props {
  href: string;
  icon?: IconName | "glyph";
  variant?: "primary" | "secondary" | "light" | "outline-dark" | "translucent" | "glass";
  size?: "sm" | "md";
  class?: string;
}

const { href, icon, variant = "primary", size = "md", class: className } = Astro.props;

const variants = {
  primary: "bg-accent text-night hover:bg-accent-strong",
  secondary: "bg-surface text-ink hover:bg-raised",
  light: "bg-ink text-night hover:bg-ink/90",
  "outline-dark": "bg-ink/10 text-ink hover:bg-ink/15",
  translucent: "bg-ink/10 text-ink hover:bg-ink/15",
  glass: "bg-surface text-ink hover:bg-raised",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-3 text-[15px]",
};
---

<a
  class:list={[
    "corner-frame inline-flex items-center justify-center gap-2 rounded-[3px] font-mono font-medium transition-[transform,background-color,color] duration-150 ease-[cubic-bezier(.22,1,.36,1)] active:scale-[0.97] motion-reduce:transform-none",
    variants[variant],
    sizes[size],
    className,
  ]}
  href={href}
>
  {
    icon === "glyph" ? (
      <span class="glyph-logo size-4 shrink-0" aria-hidden="true" />
    ) : (
      icon && <UiIcon name={icon} class="size-4 shrink-0" />
    )
  }
  <slot />
</a>
