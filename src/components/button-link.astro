---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  icon?: string;
  variant?: "primary" | "secondary" | "light" | "outline-dark" | "translucent" | "glass";
  size?: "sm" | "md";
  class?: string;
}

const { href, icon, variant = "primary", size = "md", class: className } = Astro.props;

const variants = {
  primary: "bg-accent text-night hover:bg-accent-strong",
  secondary: "bg-surface text-ink hover:bg-[#181818]",
  light: "bg-white text-night hover:bg-white/90",
  "outline-dark": "bg-white/10 text-white hover:bg-white/15",
  translucent: "bg-white/10 text-white hover:bg-white/15",
  glass: "bg-[#1f1f1f] text-white hover:bg-[#2a2a2a]",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
};
---

<a
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold transition-[transform,background-color,color] duration-150 ease-[cubic-bezier(.22,1,.36,1)] active:scale-[0.97] motion-reduce:transform-none",
    variants[variant],
    sizes[size],
    className,
  ]}
  href={href}
>
  {
    icon === "glyph" ? (
      <span class="glyph-logo size-4 shrink-0" aria-hidden="true" />
    ) : (
      icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />
    )
  }
  <slot />
</a>
