---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "light" | "outline-dark";
  size?: "sm" | "md";
  class?: string;
}

const { href, variant = "primary", size = "md", class: className } = Astro.props;

const variants = {
  primary: "bg-accent text-white hover:bg-accent-strong",
  secondary: "border border-line bg-surface text-ink hover:border-ink",
  light: "bg-white text-ink hover:bg-white/90",
  "outline-dark": "border border-white/30 text-white hover:bg-white/10",
};

const sizes = {
  sm: "px-4 py-2",
  md: "px-5 py-3",
};
---

<a
  class:list={[
    "inline-flex items-center justify-center rounded-full text-sm font-medium transition-colors duration-150",
    variants[variant],
    sizes[size],
    className,
  ]}
  href={href}
>
  <slot />
</a>
