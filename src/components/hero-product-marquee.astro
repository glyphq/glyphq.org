---
import { showcaseProducts } from "../data/showcase";
import { products } from "../data/site";
import HeroProductChip from "./hero-product-chip.astro";

const items = [
  ...products.map((product) => ({
    key: product.slug,
    label: product.name,
    href: product.href,
    glyph: true,
  })),
  ...showcaseProducts.map((product) => ({
    key: product.title,
    label: product.title,
    href: product.href,
    image: product.favicon,
    external: true,
  })),
];
---

<nav
  class="hero-marquee mx-auto mt-10 w-full max-w-[900px] overflow-hidden"
  aria-label="Glyph products and apps"
>
  <div class="hero-marquee-track flex w-max">
    <ul class="flex shrink-0 items-center gap-3 pr-3">
      {
        items.map((item) => (
          <li class="shrink-0">
            <HeroProductChip {...item} />
          </li>
        ))
      }
    </ul>
    <ul class="flex shrink-0 items-center gap-3 pr-3" aria-hidden="true" inert>
      {
        items.map((item) => (
          <li class="shrink-0">
            <HeroProductChip {...item} />
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .hero-marquee {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .hero-marquee-track {
    animation: hero-marquee 34s linear infinite;
    will-change: transform;
  }

  .hero-marquee:hover .hero-marquee-track,
  .hero-marquee:focus-within .hero-marquee-track {
    animation-play-state: paused;
  }

  @keyframes hero-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee-track {
      animation: none;
    }
  }
</style>
