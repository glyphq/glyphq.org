---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ol class="my-7 space-y-4">
  {
    items.map((item, index) => (
      <li class="flex gap-4">
        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-surface font-mono text-xs text-accent-soft">
          {index + 1}
        </span>
        <span class="text-sm leading-7 text-muted">{item}</span>
      </li>
    ))
  }
</ol>
