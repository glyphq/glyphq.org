---
interface Props {
  title: string;
  description?: string;
  href: string;
  external?: boolean;
}

const { title, description, href, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  class="corner-frame my-6 block rounded-[4px] bg-ink/[0.03] p-4 transition-colors duration-150 hover:bg-ink/[0.06]"
>
  <span class="block font-medium text-ink">{title}</span>
  {
    description && (
      <span class="mt-0.5 block text-sm leading-6 text-muted">{description}</span>
    )
  }
</a>
