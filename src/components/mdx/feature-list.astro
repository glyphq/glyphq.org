---
import { Icon } from "astro-icon/components";

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="my-7 grid gap-3 sm:grid-cols-2">
  {
    items.map((item) => (
      <li class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.025] p-3 text-sm leading-6 text-muted">
        <Icon
          name="solar:check-circle-linear"
          class="mt-0.5 size-4 shrink-0 text-accent-soft"
          aria-hidden="true"
        />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
