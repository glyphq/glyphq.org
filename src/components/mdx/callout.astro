---
interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;

const styles = {
  note: { label: "Note", tone: "bg-ink/[0.035]" },
  tip: { label: "Tip", tone: "bg-accent/[0.07]" },
  warning: { label: "Heads up", tone: "bg-orange-400/[0.07]" },
};

const style = styles[type];
---

<aside class={`my-7 rounded-2xl p-5 ${style.tone}`}>
  <p class="text-sm font-medium text-ink">{title ?? style.label}</p>
  <div class="mt-2 text-sm leading-7 text-muted [&_a]:text-accent-soft [&_a]:underline [&_a]:underline-offset-4 [&_p]:mt-2 [&_strong]:font-medium [&_strong]:text-ink">
    <slot />
  </div>
</aside>
