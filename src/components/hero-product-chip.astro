---
interface Props {
  label: string;
  href: string;
  glyph?: boolean;
  image?: string;
  external?: boolean;
}

const { label, href, glyph = false, image, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white/5 py-1.5 pl-2 pr-3.5 text-sm font-medium text-white/70 transition-colors duration-150 hover:bg-white/10 hover:text-white"
>
  {
    glyph ? (
      <span class="glyph-logo size-4 text-accent-soft" aria-hidden="true" />
    ) : (
      <img
        src={image}
        alt=""
        width="16"
        height="16"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="size-4 rounded-[4px] object-contain"
      />
    )
  }
  <span>{label}</span>
</a>
