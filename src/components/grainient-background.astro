---
import Grainient from "./grainient";
---

<div class="pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 overflow-hidden opacity-20" aria-hidden="true">
  <Grainient
    client:load
    colors={["#120f17", "#2a0f0a", "#9a3412", "#f97316", "#fed7aa"]}
    angle={55}
    flow={0.8}
    silk={0.35}
    grainAmount={0.08}
    intro={false}
    className="h-full w-full"
  />
</div>
