---
import Grainient from "./grainient";
---

<div class="pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 overflow-hidden rounded-b-[2rem] opacity-20" aria-hidden="true">
  <Grainient
    client:load
    colors={["#0d0e0a", "#1a1c0e", "#4d5327", "#aab06a", "#fafccc"]}
    angle={55}
    flow={0.8}
    silk={0.35}
    grainAmount={0.08}
    intro={false}
    className="h-full w-full"
  />
</div>
