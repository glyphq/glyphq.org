---
import AmbientBackground from "./ambient-background.astro";
import Reveal from "./reveal.astro";

interface Props {
  title: string;
  description: string;
  variant?: "default" | "article";
  align?: "left" | "center";
  compact?: boolean;
}

const { title, description, variant = "default", align = "left", compact = false } = Astro.props;
const isArticle = variant === "article";
const isCenter = align === "center";
---

<section
  class:list={[
    "relative flex px-4 md:px-8",
    isArticle
      ? "pb-8 pt-28 md:pt-32"
      : compact
        ? "pb-6 pt-24 md:pb-8 md:pt-28"
        : "min-h-[75dvh] items-center pb-8 pt-24 md:pt-28",
  ]}
>
  <AmbientBackground />
  <Reveal
    class:list={[
      "relative z-10 w-full",
      isArticle
        ? "mx-auto max-w-6xl text-left"
        : [
            compact ? "py-8 md:py-12" : "py-12 md:py-20",
            isCenter ? "text-center" : "text-left",
          ],
    ]}
  >
    {
      !isArticle && (
        <span
          class:list={[
            "glyph-logo mb-5 block size-9 text-ink md:size-11",
            isCenter && "mx-auto",
          ]}
          aria-hidden="true"
        />
      )
    }
    <h1
      transition:name="page-title"
      class:list={[
        "text-balance text-ink",
        isArticle
          ? "max-w-3xl text-[2.5rem] leading-[1.08] tracking-[-0.03em] md:text-[52px]"
          : "mx-auto max-w-4xl text-[2.75rem] leading-[1.0] tracking-[-0.035em] md:text-[64px]",
      ]}
    >
      {title}
    </h1>
    <p
      class:list={[
        "text-pretty text-ink/75",
        isArticle
          ? "mt-4 max-w-3xl text-base leading-7 md:text-[19px] md:leading-[1.5]"
          : "mx-auto mt-5 max-w-2xl text-base leading-7 md:text-[19px] md:leading-[1.5]",
      ]}
    >
      {description}
    </p>
    {
      Astro.slots.has("default") && (
        <div class:list={["mt-8 flex", isCenter && "justify-center"]}>
          <slot />
        </div>
      )
    }
  </Reveal>
</section>
