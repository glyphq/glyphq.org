---
import Reveal from "./reveal.astro";

interface Props {
  title: string;
  description: string;
  variant?: "default" | "article";
  align?: "left" | "center";
  compact?: boolean;
}

const { title, description, variant = "default", align = "center", compact = false } = Astro.props;
const isArticle = variant === "article";
const isCenter = align === "center";
---

<section
  data-asciify-hero
  class:list={[
    "relative isolate flex px-4 md:px-8",
    isArticle
      ? "pb-8 pt-28 md:pt-32"
      : compact
        ? "pb-6 pt-24 md:pb-8 md:pt-28"
        : "min-h-[64dvh] items-center pb-8 pt-24 md:pt-28",
  ]}
>
  <Reveal
    class:list={[
      "relative z-10 w-full",
      isArticle
        ? ["mx-auto max-w-6xl", isCenter ? "text-center" : "text-left"]
        : [
            compact ? "py-8 md:py-12" : "py-12 md:py-20",
            isCenter ? "text-center" : "text-left",
          ],
    ]}
  >
    {
      !isArticle && (
        <span
          class:list={[
            "glyph-logo mb-5 block size-9 text-ink md:size-11",
            isCenter && "mx-auto",
          ]}
          aria-hidden="true"
        />
      )
    }
    <div class="asciify-copy" data-asciify-clear>
      <h1
        class:list={[
          "text-balance text-ink",
          isArticle
            ? [
                isCenter && "mx-auto",
                "max-w-3xl text-[2.5rem] leading-[1.08] tracking-[-0.03em] md:text-[52px]",
              ]
            : [
                isCenter && "mx-auto",
                "max-w-4xl text-[2.75rem] leading-[1.0] tracking-[-0.035em] md:text-[64px]",
              ],
        ]}
      >
        <span class="inline-block max-w-full" transition:name="page-title">{title}</span>
      </h1>
      <p
        transition:name="page-description"
        class:list={[
          "text-pretty text-ink/75",
          isArticle
            ? [
                "mt-4 max-w-3xl text-base leading-7 md:text-[19px] md:leading-[1.5]",
                isCenter && "mx-auto",
              ]
            : [
                "mt-5 max-w-2xl text-base leading-7 md:text-[19px] md:leading-[1.5]",
                isCenter && "mx-auto",
              ],
        ]}
      >
        {description}
      </p>
    </div>
    {
      Astro.slots.has("default") && (
        <div class:list={["mt-8 flex", isCenter && "justify-center"]}>
          <slot />
        </div>
      )
    }
  </Reveal>
</section>
