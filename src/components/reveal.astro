---
interface Props {
  duration?: "fast" | "cinematic";
  preset?: "decode" | "dither" | "terminal" | "blueprint";
  class?: string;
}

const { duration = "fast", preset = "decode", class: className } = Astro.props;
---

<div
  class:list={["relative", className]}
  data-ascii-reveal
  data-reveal-duration={duration}
  data-reveal-preset={preset}
>
  <slot />
</div>
