---
interface Props {
  id?: string;
  tone?: "light" | "dark";
  class?: string;
}

const { id, tone = "light", class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    "border-b",
    tone === "dark" ? "border-white/10 bg-night text-white" : "border-line bg-paper",
    className,
  ]}
>
  <div class="mx-auto max-w-[1120px] px-4 py-20 md:px-6 md:py-24">
    <slot />
  </div>
</section>
