---
import GradientASCII from "./gradient-ascii";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={[
    "pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-[#0f0f0f]",
    className,
  ]} aria-hidden="true">
  <GradientASCII
    client:load
    colors={["#1e3fd8", "#f6f8ff", "#a5d8ff", "#38bdf8"]}
    shape="horizon"
    characters=" =+xX0S8#@"
    cellSize={18}
    density={0.8}
    glyphOpacity={0.85}
    glow={0.2}
    depthOfField={0}
    flicker={0.2}
    softness={0.5}
    scale={1}
    flow={0.5}
    speed={1}
    gradientOpacity={0.9}
    grain={0.08}
    variation={0}
    mouseInteraction={false}
    scrambleRadius={0.1}
    clickEffect="wave"
    intro={false}
    lightMode={false}
    fontFamily={'"Geist Mono Variable", "Geist Mono", ui-monospace, monospace'}
  />
  <div class="absolute inset-0 bg-[#0f0f0f]/55"></div>
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-paper md:h-32"></div>
</div>
