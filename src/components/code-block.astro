---
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = "bash" } = Astro.props;
const html = await codeToHtml(code.trim(), { lang, theme: "vesper" });
---

<div
  class="overflow-x-auto rounded-[4px] bg-code font-mono text-sm [&_pre]:rounded-[4px] [&_pre]:!bg-transparent [&_pre]:p-4"
  set:html={html}
/>
