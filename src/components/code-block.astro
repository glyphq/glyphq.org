---
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = "bash" } = Astro.props;
const html = await codeToHtml(code.trim(), { lang, theme: "vesper" });
---

<div
  class="overflow-x-auto rounded-xl bg-[#1A1513] p-4 font-mono text-sm [&_pre]:!bg-transparent"
  set:html={html}
/>
