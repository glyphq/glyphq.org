---
interface Props {
  title: string;
  description?: string;
  align?: "left" | "center";
  size?: "md" | "lg";
  class?: string;
}

const { title, description, align = "left", size = "md", class: className } = Astro.props;

const titleSize =
  size === "lg"
    ? "text-[2.25rem] leading-[1.05] tracking-[-0.03em] md:text-[3.5rem]"
    : "text-[2rem] leading-[1.08] tracking-[-0.025em] md:text-[3rem]";
---

<div class:list={[align === "center" && "text-center", className]}>
  <h2 class:list={["tracking-[-0.025em] text-ink", titleSize]}>{title}</h2>
  {
    description && (
      <p
        class:list={[
          "mt-5 text-pretty text-base leading-8 text-muted md:mt-6 md:text-[1.1875rem] md:leading-[1.55]",
          align === "center" ? "mx-auto max-w-2xl" : "max-w-2xl",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
