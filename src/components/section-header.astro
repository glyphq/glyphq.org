---
interface Props {
  title: string;
  description?: string;
  align?: "left" | "center";
  size?: "md" | "lg";
  class?: string;
}

const { title, description, align = "left", size = "md", class: className } = Astro.props;

const titleSize =
  size === "lg" ? "text-4xl leading-[1.05] md:text-[56px]" : "text-4xl leading-[1.1] md:text-5xl";
---

<div class:list={[align === "center" && "text-center", className]}>
  <h2 class:list={["tracking-[-0.025em] text-ink", titleSize]}>{title}</h2>
  {
    description && (
      <p
        class:list={[
          "mt-5 text-base leading-7 text-muted md:text-[19px] md:leading-[1.45]",
          align === "center" ? "mx-auto max-w-2xl" : "max-w-2xl",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
