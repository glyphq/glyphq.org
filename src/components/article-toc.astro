---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "desktop" | "mobile";
  class?: string;
}

const { headings, variant = "desktop", class: className } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 &&
  (variant === "mobile" ? (
    <details
      class:list={["rounded-2xl bg-ink/[0.03] p-4", className]}
      data-toc-nav
    >
      <summary class="cursor-pointer text-sm font-medium text-ink">On this page</summary>
      <ol class="mt-3 space-y-2 text-sm">
        {items.map((heading) => (
          <li class:list={["leading-5", heading.depth === 3 && "pl-3"]}>
            <a
              data-toc-link
              class="text-muted transition-colors hover:text-accent-soft"
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav class:list={["text-sm", className]} aria-label="Table of contents" data-toc-nav>
      <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">On this page</p>
      <div class="relative mt-3">
        <span class="absolute inset-y-0 left-0 w-px bg-ink/10" aria-hidden="true" />
        <span
          data-toc-progress
          class="absolute left-0 top-0 w-px bg-accent-soft"
          aria-hidden="true"
        />
        <ol class="space-y-2 pl-4">
          {items.map((heading) => (
            <li class:list={["leading-5", heading.depth === 3 && "pl-3"]}>
              <a
                data-toc-link
                class="text-muted transition-colors hover:text-accent-soft"
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  ))
}

<style>
  [data-toc-link] {
    position: relative;
    display: inline-block;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  [data-toc-link][data-active] {
    color: var(--color-accent-soft);
    transform: translateX(2px);
  }

  [data-toc-progress] {
    height: var(--toc-progress, 0%);
    transition: height 120ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-link],
    [data-toc-progress] {
      transition: none;
    }
  }
</style>

<script>
  const tocWindow = window as typeof window & { __glyphToc?: boolean };

  if (!tocWindow.__glyphToc) {
    tocWindow.__glyphToc = true;

    let cleanup: (() => void) | undefined;

    const init = () => {
      cleanup?.();

      const article = document.querySelector("article");
      const navs = Array.from(document.querySelectorAll<HTMLElement>("[data-toc-nav]"));
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));

      if (!article || !navs.length || !links.length) return;

      const headings = Array.from(article.querySelectorAll<HTMLElement>("h2[id], h3[id]"));
      if (!headings.length) return;

      let frame = 0;

      const update = () => {
        const articleTop = window.scrollY + article.getBoundingClientRect().top;
        const articleHeight = Math.max(article.offsetHeight, 1);
        const progress = Math.min(
          1,
          Math.max(0, (window.scrollY + window.innerHeight * 0.35 - articleTop) / articleHeight),
        );

        let activeId = headings[0]?.id;

        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= 160) activeId = heading.id;
        }

        for (const nav of navs) {
          nav.style.setProperty("--toc-progress", `${(progress * 100).toFixed(2)}%`);
        }

        for (const link of links) {
          const active = link.getAttribute("href") === `#${activeId}`;
          link.toggleAttribute("data-active", active);

          if (active) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      };

      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          update();
        });
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();

      cleanup = () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        if (frame) cancelAnimationFrame(frame);
      };
    };

    init();
    document.addEventListener("astro:page-load", init);
  }
</script>
