---
interface Props {
  class?: string;
  tone?: "light" | "dark";
  transitionName?: string;
}

const { class: className, tone = "light", transitionName } = Astro.props;
---

<a
  class:list={["flex w-fit items-center gap-2", className]}
  href="/"
  aria-label="Glyph home"
  transition:name={transitionName}
>
  <span class="glyph-logo size-7" aria-hidden="true" />
  <span
    class:list={[
      "font-display text-lg font-semibold tracking-tight",
      tone === "dark" ? "text-ink" : "text-ink",
    ]}>Glyph</span
  >
</a>
