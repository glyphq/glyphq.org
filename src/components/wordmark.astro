---
interface Props {
  class?: string;
  tone?: "light" | "dark";
  label?: string;
  showMark?: boolean;
}

const { class: className, tone = "light", label = "Glyph", showMark = true } = Astro.props;
---

<a
  class:list={["flex w-fit items-center gap-2", className]}
  href="/"
  aria-label={`${label} home`}
>
  {showMark && <span class="glyph-logo size-7" aria-hidden="true" />}
  <span
    class:list={[
      "whitespace-nowrap font-display text-lg font-semibold tracking-tight",
      tone === "dark" ? "text-ink" : "text-ink",
    ]}>{label}</span
  >
</a>
