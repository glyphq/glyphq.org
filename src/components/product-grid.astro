---
import type { Product } from "../data/site";
import ProductCard from "./product-card.astro";

interface Props {
  products: Product[];
  class?: string;
}

const { products, class: className } = Astro.props;
---

<div class:list={["grid items-stretch gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3", className]}>
  {products.map((product) => <ProductCard {...product} />)}
</div>
