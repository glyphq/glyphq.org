---
import type { Product } from "../data/site";

interface Props extends Pick<Product, "slug" | "name" | "summary" | "href"> {
  class?: string;
}

const { slug, name, summary, href, class: className } = Astro.props;
---

<a
  id={slug}
  transition:name={`product-${slug}`}
  class:list={["flex scroll-mt-24 flex-col p-6 md:p-8", className]}
  href={href}
>
  <img src="/brand/glyph-on-dark.png" alt="" width="28" height="28" class="size-7" />
  <h3 class="mt-8 text-xl font-medium tracking-tight text-ink">{name}</h3>
  <p class="mt-2 text-base leading-7 text-muted">{summary}</p>
</a>
