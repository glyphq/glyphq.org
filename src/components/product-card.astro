---
import type { Product } from "../data/site";
import HairlineMask from "./hairline-mask.astro";

interface Props extends Pick<Product, "slug" | "name" | "summary" | "href"> {}

const { slug, name, summary, href } = Astro.props;
---

<a
  data-scroll-reveal
  id={slug}
  transition:name={`product-${slug}`}
  class="group relative block scroll-mt-24 overflow-hidden rounded-2xl bg-surface p-6 transition-colors duration-150 hover:bg-[#1C1A1A] md:p-7"
  href={href}
>
  <HairlineMask variant={slug} />
  <div class="relative z-10 flex flex-col">
    <span class="glyph-logo size-6" aria-hidden="true" />
    <h3 class="mt-6 text-lg font-medium tracking-tight text-ink">{name}</h3>
    <p class="mt-2 text-sm leading-6 text-muted">{summary}</p>
  </div>
</a>
