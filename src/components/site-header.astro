---
import NavMenu from "./nav-menu";
import Wordmark from "./wordmark.astro";

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-night/95 text-white backdrop-blur">
  <div
    class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between gap-6 border-x border-white/10 px-4 md:px-8"
  >
    <Wordmark transitionName="wordmark" />
    <NavMenu client:load pathname={pathname} />
  </div>
</header>
