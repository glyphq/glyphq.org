---
import NavMenu from "./nav-menu";
import Wordmark from "./wordmark.astro";

const pathname = Astro.url.pathname;
---

<header data-header class="fixed inset-x-0 top-0 z-50 text-ink transition-[background-color] duration-300">
  <div class="flex h-[72px] w-full items-center justify-between gap-6 px-4 md:px-8">
    <Wordmark transitionName="wordmark" tone="dark" />
    <NavMenu client:load pathname={pathname} />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const syncHeader = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });
  document.addEventListener("astro:page-load", syncHeader);
</script>

<style>
  [data-header][data-scrolled] {
    background-color: color-mix(in srgb, var(--color-paper) 82%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    backdrop-filter: blur(18px) saturate(120%);
  }
</style>

<script>
  import { ANALYTICS_URL } from "../lib/analytics";

  let progress: string | null = null;

  const render = () => {
    document.querySelectorAll<HTMLElement>("[data-support-progress]").forEach((chip) => {
      if (!progress) {
        chip.hidden = true;
        return;
      }
      if (chip.textContent !== progress) chip.textContent = progress;
      chip.title = `Development window ${progress} funded`;
      chip.hidden = false;
    });
  };

  const load = async () => {
    try {
      const response = await fetch(`${ANALYTICS_URL}/support?ttl=300`);
      if (!response.ok) throw new Error("Support analytics request failed");
      const data = (await response.json()) as { progress?: { label?: string } };
      progress = data.progress?.label ?? null;
    } catch {
      progress = null;
    }
    render();
  };

  void load();
  window.setInterval(load, 5 * 60_000);
  new MutationObserver((mutations) => {
    if (mutations.some((mutation) => mutation.addedNodes.length > 0)) render();
  }).observe(document.body, { childList: true, subtree: true });
</script>
