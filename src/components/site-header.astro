---
import NavMenu from "./nav-menu";
import Wordmark from "./wordmark.astro";

const pathname = Astro.url.pathname;
---

<header class="absolute inset-x-0 top-0 z-40 text-ink">
  <div
    class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between gap-6 px-4 md:px-8"
  >
    <Wordmark transitionName="wordmark" tone="dark" />
    <NavMenu client:load pathname={pathname} />
  </div>
</header>
