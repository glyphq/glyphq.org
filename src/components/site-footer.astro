---
import { footerColumns } from "../data/site";
import AmbientBackground from "./ambient-background.astro";
import Wordmark from "./wordmark.astro";
---

<footer class="relative overflow-hidden rounded-t-[2rem] bg-surface">
  <AmbientBackground variant="footer" />
  <div class="relative z-10 mx-auto max-w-[1280px]">
    <div class="px-4 py-20 md:px-8 md:py-24">
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-10">
        <div class="col-span-2 space-y-4 md:col-span-1">
          <Wordmark />
          <p class="max-w-xs text-base leading-7 text-muted">
            Glyph is a desktop wallet and explorer for Qubic, with tools for connected apps.
          </p>
          <div class="flex flex-col items-start gap-2 pt-2">
            <span class="font-space text-xs text-muted">Listed on</span>
            <a
              href="https://qubicmap.org/p/glyph"
              target="_blank"
              rel="noreferrer"
              aria-label="View Glyph on qubicmap.org"
              class="inline-flex items-center gap-2 rounded-xl bg-paper px-3.5 py-2 text-xs text-ink/70 transition-colors duration-150 hover:bg-ink/5 hover:text-ink"
            >
              <span
                class="size-3.5 shrink-0 bg-accent-soft"
                style="mask-image: url('/chains/qubic.svg'); -webkit-mask-image: url('/chains/qubic.svg'); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-size: contain; -webkit-mask-size: contain; mask-position: center; -webkit-mask-position: center;"
                aria-hidden="true"
              ></span>
              <span class="whitespace-nowrap font-space text-[12px]">qubicmap.org</span>
            </a>
          </div>
        </div>

        {
          footerColumns.map((column) => (
            <div class="space-y-4">
              <p class="text-sm text-muted">{column.title}</p>
              <ul class="space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      class="text-base text-ink/75 underline-offset-4 transition-colors duration-150 hover:text-ink hover:underline"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <div
        class="flex flex-col gap-3 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between md:px-8"
      >
        <p>© 2026 Glyph</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="hover:text-ink" href="https://github.com/glyphq">GitHub</a>
          <a class="hover:text-ink" href="https://docs.glyphq.org">Documentation</a>
        </div>
      </div>
    </div>
  </div>
</footer>
