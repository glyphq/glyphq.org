---
import { footerColumns } from "../data/site";
import Wordmark from "./wordmark.astro";
---

<footer class="relative overflow-hidden border-t border-line bg-paper">
  <div class="relative mx-auto w-full max-w-[1280px] border-x border-line">
    <div class="px-4 py-16 md:px-8 md:py-20">
      <div
        class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-x-0 md:divide-x md:divide-line"
      >
        <div class="col-span-2 space-y-4 md:col-span-1 md:pr-8">
          <Wordmark showMark={false} />
          <p class="max-w-xs text-base leading-7 text-muted">
            Glyph is a desktop wallet and explorer for Qubic, with tools for connected apps.
          </p>
          <div class="flex flex-col items-start gap-2 pt-2">
            <span class="font-mono text-[10px] tracking-[0.06em] text-faint">Listed on</span>
            <a
              href="https://qubicmap.org/p/glyph"
              target="_blank"
              rel="noreferrer"
              aria-label="View Glyph on qubicmap.org"
              class="corner-frame inline-flex items-center rounded-[3px] bg-surface px-3.5 py-2 text-xs text-ink/70 transition-colors duration-150 hover:bg-raised hover:text-ink"
            >
              <span class="whitespace-nowrap font-mono text-[11px]">qubicmap.org</span>
            </a>
          </div>
        </div>

        {
          footerColumns.map((column) => (
            <div class="space-y-4 md:pl-8">
              <p class="font-mono text-[11px] tracking-[0.04em] text-faint">{column.title}</p>
              <ul class="space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      class="font-mono text-[13px] text-ink/70 underline-offset-4 transition-colors duration-150 hover:text-ink hover:underline"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="border-t border-line">
      <div
        class="flex flex-col gap-3 px-4 py-5 font-mono text-[11px] text-faint sm:flex-row sm:items-center sm:justify-between md:px-8"
      >
        <p>© 2026 Glyph</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="hover:text-ink" href="https://github.com/glyphq">GitHub</a>
          <a class="hover:text-ink" href="https://docs.glyphq.org">Documentation</a>
        </div>
      </div>
    </div>
  </div>
</footer>
