---
import { Icon } from "astro-icon/components";
import { principles } from "../data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["grid border-t border-line md:grid-cols-3 md:divide-x md:divide-line", className]}>
  {
    principles.map((principle) => (
      <div class="py-10 md:px-8 md:first:pl-0 md:last:pr-0">
        <Icon name={principle.icon} class="size-6 text-accent-soft" aria-hidden="true" />
        <h3 class="mt-4 text-base font-medium text-ink">{principle.title}</h3>
        <p class="mt-2 text-base leading-7 text-muted">{principle.description}</p>
      </div>
    ))
  }
</div>
