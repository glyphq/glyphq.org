---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a
  data-scroll-reveal
  href={href}
  target="_blank"
  rel="noreferrer"
  class="corner-frame corner-frame-card group relative flex h-full flex-col overflow-hidden rounded-[4px] bg-surface p-5 transition-colors duration-150 hover:bg-raised focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent md:p-6"
>
  <div class="relative z-10 flex flex-col">
    <div class="relative aspect-[1.91/1] overflow-hidden rounded-[3px] bg-paper">
      <div class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm font-medium text-muted">
        {title}
      </div>
      {
        image && (
          <img
            src={image}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover grayscale transition-[filter] duration-300 group-hover:grayscale-0"
          />
        )
      }
    </div>
    <h2 class="mt-5 text-2xl font-medium tracking-tight text-ink">{title}</h2>
    <p class="mt-2 text-base leading-7 text-muted">{description}</p>
  </div>
</a>
