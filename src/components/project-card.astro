---
import HairlineMask from "./hairline-mask.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  class="group relative flex flex-col overflow-hidden transition-colors duration-150 hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent-soft"
>
  <HairlineMask class="hairline-mask--bottom" />
  <div class="relative z-10 flex flex-col">
    <div class="relative aspect-[1.91/1] overflow-hidden rounded-2xl bg-[#0f1b33]">
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-white/70">
        <span class="glyph-logo size-10" aria-hidden="true" />
        <span class="text-sm font-medium">{title}</span>
      </div>
      {
        image && (
          <img
            src={image}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        )
      }
    </div>
    <h2 class="mt-6 text-2xl font-medium tracking-tight text-ink">{title}</h2>
    <p class="mt-2 text-base leading-7 text-muted">{description}</p>
  </div>
</a>
