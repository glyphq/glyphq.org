---
import { Icon } from "astro-icon/components";
import QRCode from "qrcode";
import CopyButton from "./copy-button";

interface Props {
  identity: string;
}

const { identity } = Astro.props;
const explorerUrl = `https://explorer.glyphq.org/accounts/${identity}`;
const qrSvg = await QRCode.toString(identity, {
  type: "svg",
  errorCorrectionLevel: "H",
  margin: 0,
  color: { dark: "#151311", light: "#EED3BA" },
});
---

<div data-donate-root>
  <button
    type="button"
    data-donate-open
    class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 font-display text-base font-semibold text-night transition-colors duration-150 hover:bg-accent-strong"
  >
    <span class="glyph-logo size-4" aria-hidden="true" />
    Donate QU
  </button>

  <dialog data-donate-dialog aria-labelledby="donate-title" class="donate-dialog">
    <div class="h-full w-full overflow-y-auto rounded-3xl bg-surface p-6 shadow-2xl shadow-black/50">
      <div class="flex items-start justify-between gap-5">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">Support Glyph</p>
          <h2 id="donate-title" class="mt-2 text-2xl font-medium tracking-tight text-ink">
            Donate to Glyph
          </h2>
        </div>
        <button
          type="button"
          data-donate-close
          aria-label="Close donation dialog"
          class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-ink/10 text-muted transition-colors hover:bg-ink/15 hover:text-ink"
        >
          <Icon name="solar:close-linear" class="size-4" aria-hidden="true" />
        </button>
      </div>

      <p class="mt-4 text-sm leading-6 text-muted">
        Scan with a Qubic wallet, or copy the identity below.
      </p>

      <div
        class="relative mt-5 aspect-square w-full overflow-hidden rounded-2xl bg-[#EED3BA] p-2"
        role="img"
        aria-label="QR code for the Glyph donation identity"
      >
        <div class="h-full w-full [&_svg]:h-full [&_svg]:w-full" set:html={qrSvg} />
      </div>

      <div class="mt-4 rounded-2xl bg-paper p-3">
        <code class="block break-all font-mono text-xs leading-5 text-ink/75">
          {identity}
        </code>
      </div>

      <div class="mt-4 grid gap-2">
        <CopyButton
          value={identity}
          label="Qubic identity"
          text="Copy address"
          fullWidth
          client:load
        />
        <a
          href={explorerUrl}
          class="inline-flex w-full items-center justify-center rounded-full bg-ink/10 px-4 py-3 font-display text-sm font-semibold text-ink transition-colors duration-150 hover:bg-ink/15"
          target="_blank"
          rel="noreferrer"
        >
          Open in Explorer
        </a>
      </div>
    </div>
  </dialog>
</div>

<style is:global>
  .donate-dialog {
    position: fixed;
    inset: 0;
    width: min(92vw, 28rem);
    max-width: 28rem;
    height: min(92dvh, 48rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    overflow-y: auto;
    background: transparent;
    color: var(--color-ink);
  }

  .donate-dialog::backdrop {
    background: rgb(21 19 17 / 0.72);
    backdrop-filter: blur(8px);
  }

  .donate-dialog[open] {
    animation: donate-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes donate-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .donate-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  const initialize = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-donate-root]")) {
      if (root.dataset.ready) continue;

      const dialog = root.querySelector<HTMLDialogElement>("[data-donate-dialog]");
      const open = root.querySelector<HTMLButtonElement>("[data-donate-open]");
      if (!dialog || !open) continue;

      root.dataset.ready = "true";

      open.addEventListener("click", () => dialog.showModal());
      dialog.querySelectorAll("[data-donate-close]").forEach((button) => {
        button.addEventListener("click", () => dialog.close());
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => open.focus());
    }
  };

  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
