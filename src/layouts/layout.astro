---
import "../styles/global.css";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Glyph: open-source tools for Qubic",
  description = "The Glyph stack for Qubic: a self-custodial wallet, explorer, Connect SDK, typed contracts, and indexed API.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2"
      href="#main">Skip to content</a
    >
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
