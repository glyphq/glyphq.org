---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Glyph: a wallet and toolchain for Qubic",
  description = "Glyph is a self-custodial wallet and toolchain for Qubic.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#151311" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <noscript>
      <style>
        [data-scroll-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2"
      href="#main">Skip to content</a
    >
    <SiteHeader />
    <main id="main" class="flex-1">
      <div class="mx-auto w-full max-w-[1280px]">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <script>
      import "../scripts/scroll-reveal";
    </script>
  </body>
</html>
