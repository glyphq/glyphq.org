---
import ButtonLink from "../components/button-link.astro";
import HeroBackdrop from "../components/hero-backdrop.astro";
import Layout from "../layouts/layout.astro";
---

<Layout
  title="Page not found | Glyph"
  description="The page you asked for does not exist."
  noindex
>
  <section class="relative bg-[#0f0f0f] px-4 py-8 md:px-8">
    <HeroBackdrop />
    <div class="relative z-10 py-16 text-center md:py-24">
      <p class="font-mono text-sm uppercase tracking-[0.12em] text-white/50">404</p>
      <h1
        class="mx-auto mt-5 max-w-2xl text-balance text-4xl leading-[1.05] tracking-[-0.03em] text-white md:text-[64px]"
      >
        This page does not exist.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-pretty text-base leading-7 text-white/75 md:text-[19px] md:leading-[1.45]">
        The link may be old, or the page may have moved. Start from the toolchain or go back home.
      </p>
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
        <ButtonLink href="/" variant="light" icon="solar:home-smile-linear">Back home</ButtonLink>
        <ButtonLink href="/products" variant="glass" icon="solar:layers-linear">
          Browse products
        </ButtonLink>
      </div>
    </div>
  </section>
</Layout>
