---
import ButtonLink from "../components/button-link.astro";
import DownloadCount from "../components/download-count";
import DownloadHeroCta from "../components/download-hero-cta";
import DownloadPicker from "../components/download-picker";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import SectionHeader from "../components/section-header.astro";
import Layout from "../layouts/layout.astro";
import { buildPlatforms, getReleases, releasesPage } from "../lib/releases";

const [latest] = await getReleases(1);
const releaseUrl = latest?.url ?? releasesPage;
const platforms = buildPlatforms(latest);
const userGuide = "https://github.com/glyphq/wallet/blob/main/docs/USER_GUIDE.md";
const discord = "https://discord.gg/s5qNRNGu96";
const version = latest?.tag.replace(/^v/, "") ?? "";
const digests = latest?.assets.filter((asset) => asset.digest) ?? [];
const manifests = latest?.assets.filter((asset) => asset.name.startsWith("SHA256SUMS")) ?? [];
---

<Layout
  title="Download Glyph"
  description="Download the self-custodial Glyph desktop wallet for Qubic on Windows, macOS, or Linux."
>
  <PageHero
    title="Download Glyph"
    description="The self-custodial desktop wallet for Qubic. Windows, macOS, and Linux."
    align="center"
    compact
  >
    <div class="flex flex-col items-center gap-2">
      <DownloadHeroCta
        client:load
        platforms={platforms}
        releaseUrl={releaseUrl}
        version={latest?.tag ?? ""}
      />
      <p class="text-sm text-muted"><DownloadCount client:load /> total downloads</p>
    </div>
  </PageHero>

  <PageSection spacing="compact">
    <div class="mt-4">
      <SectionHeader
        title="Pick your platform"
        description="We detect your system and suggest the right build."
        align="center"
        size="lg"
      />
      <DownloadPicker client:load platforms={platforms} />
    </div>

    <div
      data-scroll-reveal
      class="corner-frame corner-frame-card mx-auto mt-10 max-w-3xl rounded-[4px] bg-surface p-5 md:p-6"
    >
      <h2 class="font-mono text-[10px] tracking-[0.08em] text-faint">System requirements</h2>
      <ul class="mt-4 grid gap-2 text-sm leading-6 text-muted sm:grid-cols-2">
        <li>Windows x64</li>
        <li>macOS, Apple Silicon and Intel</li>
        <li>Linux x86_64: AppImage, Debian, RPM</li>
        <li>Desktop only; no browser or mobile build</li>
      </ul>
      <p class="mt-4 text-sm leading-6 text-muted">Glyph does not run on 32-bit systems.</p>
      <a class="mt-4 inline-flex text-sm text-accent-soft hover:underline" href={userGuide}>
        Install guide
      </a>
    </div>

    <div
      data-scroll-reveal
      class="corner-frame corner-frame-card mx-auto mt-4 max-w-3xl rounded-[4px] bg-surface p-5 md:p-6"
    >
      <h2 class="font-mono text-[10px] tracking-[0.08em] text-faint">Verify your download</h2>
      <p class="mt-3 text-sm leading-6 text-muted">
        The release publishes SHA256SUMS files. Download the manifest for your platform, compute the
        SHA-256 digest of the file you downloaded, and compare the values.
      </p>
      <pre class="corner-frame mt-4 overflow-x-auto rounded-[4px] bg-code p-4 font-mono text-xs leading-5 text-ink/80"># macOS or Linux
shasum -a 256 Glyph.Wallet_{version}_universal.dmg
sha256sum Glyph.Wallet_{version}_amd64.AppImage

# Windows PowerShell
Get-FileHash .\Glyph.Wallet_{version}_x64-setup.exe -Algorithm SHA256</pre>
      {
        manifests.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {manifests.map((asset) => (
              <a class="text-accent-soft hover:underline" href={asset.url}>
                {asset.name}
              </a>
            ))}
          </div>
        )
      }
      {
        digests.length > 0 && (
          <details class="corner-frame mt-4 rounded-[4px] bg-code p-4">
            <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="text-sm font-medium text-ink">Show SHA-256 digests</span>
            </summary>
            <ul class="mt-3 space-y-2">
              {digests.map((asset) => (
                <li class="break-all font-mono text-xs leading-5 text-muted">
                  {asset.name}: {asset.digest}
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <p class="mt-4 text-sm leading-6 text-muted">
        If the digests differ, delete the file and download it again from the release page.
      </p>
      <a
        class="mt-3 inline-flex text-sm text-accent-soft hover:underline"
        href={latest?.url ?? releasesPage}
      >
        Open the release page
      </a>
    </div>

    {
      latest && latest.assets.length > 0 && (
        <details
          data-scroll-reveal
          class="corner-frame corner-frame-card mx-auto mt-4 max-w-3xl rounded-[4px] bg-surface p-5 md:p-6"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-left [&::-webkit-details-marker]:hidden">
            <span class="text-base font-medium text-ink">All files in {latest.tag}</span>
            <span class="text-xl leading-none text-muted" aria-hidden="true">
              +
            </span>
          </summary>
          <ul class="mt-4 space-y-2">
            {latest.assets.map((asset) => (
              <li>
                <a class="break-all text-sm text-accent-soft hover:underline" href={asset.url}>
                  {asset.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="mt-12 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="text-base text-muted">Need help installing?</p>
      <div class="flex flex-wrap gap-3">
        <ButtonLink href={userGuide} variant="secondary" icon="document">
          Install guide
        </ButtonLink>
        <ButtonLink href={discord} variant="secondary" icon="chat">
          Discord
        </ButtonLink>
      </div>
    </div>
  </PageSection>

  <script is:inline>
    (() => {
      const storageKey = "glyph-platform-v2";

      const applyPlatformHref = () => {
        const link = document.querySelector("[data-download-primary]");
        if (!link) return;

        let platform = null;
        try {
          const cached = localStorage.getItem(storageKey);
          if (cached === "windows" || cached === "macos" || cached === "linux") {
            platform = cached;
          }
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }

        if (!platform) {
          const navPlatform =
            (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            "";
          const agent = navigator.userAgent;
          const isMobile =
            /android|iphone|ipad|ipod|iemobile|mobile/i.test(agent) ||
            (/mac/i.test(navPlatform) && navigator.maxTouchPoints > 1);

          if (!isMobile) {
            if (/win/i.test(navPlatform)) platform = "windows";
            else if (/mac/i.test(navPlatform)) platform = "macos";
            else if (/linux/i.test(navPlatform)) platform = "linux";
            else if (/windows/i.test(agent)) platform = "windows";
            else if (/mac os x/i.test(agent)) platform = "macos";
            else if (/linux/i.test(agent)) platform = "linux";
          }

          if (platform) {
            try {
              localStorage.setItem(storageKey, platform);
            } catch {
              // The direct link still works for this page.
            }
          }
        }

        if (!platform) return;
        let urls = [];
        try {
          urls = JSON.parse(link.getAttribute("data-download-platforms") || "[]");
        } catch {
          return;
        }
        const match = urls.find((item) => item.id === platform);
        if (match && match.url) link.setAttribute("href", match.url);
      };

      applyPlatformHref();
      document.addEventListener("astro:page-load", applyPlatformHref);
    })();
  </script>
</Layout>
