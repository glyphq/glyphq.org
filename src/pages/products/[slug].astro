---
import { getCollection, render } from "astro:content";
import ButtonLink from "../../components/button-link.astro";
import Callout from "../../components/mdx/callout.astro";
import FeatureList from "../../components/mdx/feature-list.astro";
import LinkCard from "../../components/mdx/link-card.astro";
import Steps from "../../components/mdx/steps.astro";
import PageHero from "../../components/page-hero.astro";
import PageSection from "../../components/page-section.astro";
import ProductGrid from "../../components/product-grid.astro";
import Reveal from "../../components/reveal.astro";
import SectionHeader from "../../components/section-header.astro";
import { products } from "../../data/site";
import Layout from "../../layouts/layout.astro";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
const articles = await getCollection("products");
const article = articles.find(
  (entry) =>
    entry.id
      .split("/")
      .pop()
      ?.replace(/\.mdx?$/, "") === product.slug,
);

if (!article) {
  throw new Error(`No MDX article found for product "${product.slug}".`);
}

const { Content } = await render(article);
const mdxComponents = { Callout, FeatureList, Steps, LinkCard };
---

<Layout title={`${product.name} | Glyph`} description={product.summary}>
  <PageHero variant="article" title={product.name} description={product.summary} />

  <section class="bg-paper px-4 pb-20 pt-10 md:px-8 md:pb-28 md:pt-12">
    <Reveal>
      <article
        class="mx-auto max-w-3xl text-base leading-8 text-muted [&>h2]:mt-10 [&>h2]:text-2xl [&>h2]:font-medium [&>h2]:tracking-tight [&>h2]:text-ink [&>h3]:mt-8 [&>h3]:text-lg [&>h3]:font-medium [&>h3]:text-ink [&>p]:mt-5 [&>p]:leading-8 [&>p_a]:text-accent-soft [&>p_a]:underline [&>p_a]:underline-offset-4 [&_p_code]:rounded [&_p_code]:bg-white/5 [&_p_code]:px-1.5 [&_p_code]:py-0.5 [&_p_code]:font-mono [&_p_code]:text-[0.9em] [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:font-mono [&_pre]:mt-6 [&_pre]:overflow-x-auto [&_pre]:text-[13px] [&_pre]:leading-6 [&_pre]:rounded-2xl [&_pre]:bg-[#081417] [&_pre]:p-4 [&_strong]:font-medium [&_strong]:text-ink"
      >
        <Content components={mdxComponents} />
      </article>
    </Reveal>
  </section>

  <PageSection>
    <Reveal>
      <SectionHeader
        title="Next steps"
        description={`Use ${product.name} on its own or with the rest of the toolchain.`}
      />
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href={product.primary.href} icon={product.primary.icon}>{product.primary.label}</ButtonLink>
        {
          product.secondary && (
            <ButtonLink href={product.secondary.href} variant="secondary" icon={product.secondary.icon}>
              {product.secondary.label}
            </ButtonLink>
          )
        }
        <ButtonLink href="/products" variant="secondary" icon="solar:layers-linear">All products</ButtonLink>
      </div>
    </Reveal>
  </PageSection>

  <PageSection>
    <Reveal>
      <SectionHeader title="Related products" description="The rest of the stack." size="lg" />
      <ProductGrid products={related} class="mt-10" />
    </Reveal>
  </PageSection>
</Layout>
