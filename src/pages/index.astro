---
import ButtonLink from "../components/button-link.astro";
import Faq from "../components/faq";
import PageSection from "../components/page-section.astro";
import ProductGrid from "../components/product-grid.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { products } from "../data/site";
import Layout from "../layouts/layout.astro";

export const prerender = true;

const userGuide = "https://github.com/glyphq/wallet/blob/main/docs/USER_GUIDE.md";
---

<Layout>
  <section
    data-asciify-hero
    class="relative isolate flex min-h-[75dvh] items-center px-4 py-8 md:px-8"
  >
      <Reveal class="relative z-10 w-full py-20 text-center md:py-28">
      <div class="asciify-copy" data-asciify-clear>
        <h1 class="flex flex-col items-center">
          <span class="glyph-logo mb-5 block size-10 text-ink md:size-12" aria-hidden="true" />
          <span
            transition:name="page-title"
            class="flex flex-col items-center gap-2 md:flex-row md:gap-3"
          >
            <span class="text-[2.5rem] leading-none tracking-[-0.04em] text-ink md:text-[88px]">
              Glyph
            </span>
            <span
              class="corner-frame corner-frame-xl inline-block rounded-[4px] bg-accent px-4 py-1 text-[2.5rem] leading-none tracking-[-0.04em] text-night md:rounded-[6px] md:px-6 md:py-2 md:text-[88px]"
            >
              Ecosystem
            </span>
          </span>
        </h1>
        <p
          transition:name="page-description"
          class="mx-auto mt-6 max-w-[620px] text-pretty text-base leading-7 text-ink/75 md:text-[19px] md:leading-[1.5]"
        >
          A self-custodial desktop wallet and explorer for <span
            class="qubic-symbol mx-1 h-[1.15em] align-[-0.16em] text-ink"
            aria-hidden="true"></span> Qubic, with tools for connected apps.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <ButtonLink href="/download" variant="primary" icon="glyph">Download Glyph</ButtonLink>
        <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="globe">
          Explorer
        </ButtonLink>
      </div>
    </Reveal>
  </section>

  <section id="products" class="border-t border-line">
    <Reveal>
      <div class="px-4 pb-10 pt-16 md:px-8 md:pt-20">
        <SectionHeader
          title="The Glyph toolchain"
          description="Wallet, explorer, and developer tools for Qubic."
          align="center"
          size="lg"
        />
      </div>

      <ProductGrid products={products} class="px-4 pb-4 md:px-8 md:pb-6" />
    </Reveal>
  </section>

  <PageSection id="faq">
    <Reveal>
      <SectionHeader
        title="Frequently asked questions"
        description="Short answers about Glyph, Vaults, and using Qubic."
        align="center"
        size="lg"
      />

      <Faq client:load />

      <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-6 text-muted">
        Still need help? Read the <a class="text-accent-soft hover:underline" href={userGuide}>user guide</a> or <a class="text-accent-soft hover:underline" href="/support">contact support</a>.
      </p>
    </Reveal>
  </PageSection>
</Layout>
