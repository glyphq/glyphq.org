---
import ButtonLink from "../components/button-link.astro";
import PageSection from "../components/page-section.astro";
import ProductCard from "../components/product-card.astro";
import SectionHeader from "../components/section-header.astro";
import StackMap from "../components/stack-map.astro";
import { attributes, principles, products, specs } from "../data/site";
---

<Layout>
  <section class="bg-night px-4 pb-10 pt-6 md:px-6">
    <div class="mx-auto max-w-[1352px] rounded-2xl bg-accent px-6 py-16 text-center text-white md:py-24">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/70">
        Open-source stack for Qubic
      </p>
      <h1
        class="mx-auto mt-5 max-w-4xl text-[2.5rem] leading-[1.05] tracking-[-0.03em] md:text-[3.5rem]"
      >
        Build on Qubic without rebuilding the basics.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-white/80 md:text-base md:leading-7">
        Glyph is an open-source wallet, explorer, SDK, and API layer for Qubic. One stack, one data
        model, self-custodial by default.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <ButtonLink href="https://docs.glyphq.org" variant="light">Start building</ButtonLink>
        <ButtonLink href="#products" variant="outline-dark">See the products</ButtonLink>
      </div>
    </div>
    <StackMap />
  </section>

  <section aria-label="Platform attributes" class="border-b border-line bg-surface">
    <ul class="mx-auto grid max-w-[1120px] grid-cols-2 gap-px bg-line md:grid-cols-4">
      {
        attributes.map((attribute) => (
          <li class="bg-surface px-4 py-4 text-center font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
            {attribute}
          </li>
        ))
      }
    </ul>
  </section>

  <PageSection id="products">
    <SectionHeader
      kicker="Products"
      title="One stack for the whole network."
      description="Use one product or all of them. Each one shares the same addresses, types, and data model."
    />
    <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-4">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  </PageSection>

  <PageSection id="principles">
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <div class="md:sticky md:top-24 md:self-start">
        <SectionHeader
          kicker="Principles"
          title="Boring infrastructure, open internals."
          description="The stack is built to be read, audited, and replaced piece by piece."
        />
      </div>
      <div class="border-t border-line">
        {
          principles.map((principle) => (
            <article class="border-b border-line py-6 md:grid md:grid-cols-[7rem_1fr] md:gap-6">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                {principle.tag}
              </p>
              <div class="mt-2 space-y-2 md:mt-0">
                <h3 class="text-base font-medium">{principle.title}</h3>
                <p class="text-sm leading-6 text-muted">{principle.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </PageSection>

  <PageSection id="developers" tone="dark">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <SectionHeader
          kicker="Developers"
          title="Install the parts you need."
          description="Start with the Connect SDK, then add typed contracts or the indexed API. The docs include examples for each product."
          tone="dark"
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="https://docs.glyphq.org">Read the docs</ButtonLink>
          <ButtonLink href="https://github.com/glyphq" variant="outline-dark">
            Browse the source
          </ButtonLink>
        </div>
      </div>
      <dl class="self-start overflow-hidden rounded-lg border border-white/15">
        {
          specs.map((spec) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-white/10 px-4 py-3 last:border-b-0">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/50">
                {spec.label}
              </dt>
              <dd class="font-mono text-xs text-white/80">{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      kicker="Open source"
      title="Build on the open stack."
      description="The wallet, SDK, explorer, and API are ready for your next Qubic app."
      align="center"
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <ButtonLink href="https://docs.glyphq.org">Start building</ButtonLink>
      <ButtonLink href="https://glyphq.org/download" variant="secondary">Get the wallet</ButtonLink>
    </div>
  </PageSection>
</Layout>
