---
import { Icon } from "astro-icon/components";
import ButtonLink from "../components/button-link.astro";
import HeroBackdrop from "../components/hero-backdrop.astro";
import PageSection from "../components/page-section.astro";
import ProductGrid from "../components/product-grid.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { products } from "../data/site";
import Layout from "../layouts/layout.astro";

const userGuide = "https://github.com/glyphq/wallet/blob/main/docs/USER_GUIDE.md";

const benefits = [
  "Your keys stay on your desktop.",
  "Every app request is reviewed before you sign.",
  "One wallet for sending, receiving, and exploring Qubic.",
];

const steps = [
  {
    title: "Download and install",
    body: "Choose the Windows, macOS, or Linux build.",
  },
  {
    title: "Create a Vault",
    body: "A Vault holds your Qubic identities. Keys are generated and stored on this device.",
  },
  {
    title: "Review, then sign",
    body: "Requests show the app, contract, and action before you approve them.",
  },
];
---

<Layout>
  <section class="relative flex min-h-[75dvh] items-center bg-[#0f0f0f] px-4 py-8 md:px-8">
    <HeroBackdrop />
    <Reveal duration="cinematic" class="relative z-10 w-full py-20 text-center md:py-28">
      <h1 transition:name="page-title" class="flex flex-col items-center">
        <span class="glyph-logo mb-5 block size-10 text-white md:size-12" aria-hidden="true" />
        <span class="flex flex-nowrap items-center justify-center gap-2 md:gap-3">
          <span class="text-[1.875rem] leading-none tracking-[-0.04em] text-white md:text-[88px]">
            Glyph
          </span>
          <span
            class="inline-block rounded-2xl bg-white px-3 py-1 text-[1.875rem] leading-none tracking-[-0.04em] text-night md:rounded-3xl md:px-6 md:py-2 md:text-[88px]"
          >
            Ecosystem
          </span>
        </span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-[620px] text-pretty text-base leading-7 text-white/75 md:text-[19px] md:leading-[1.5]"
      >
        A self-custodial desktop wallet and explorer, with the tools apps use to connect to <img
          src="/brand/qubic-symbol.svg"
          alt=""
          width="31"
          height="52"
          class="mx-1 inline-block h-[1.15em] w-auto align-[-0.16em]"
        /> Qubic.
      </p>
      <div
        class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center"
      >
        <ButtonLink href="/download" variant="light" icon="glyph">Download Glyph</ButtonLink>
        <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="solar:global-linear">
          Explorer
        </ButtonLink>
      </div>
    </Reveal>
  </section>

  <section id="products">
    <Reveal>
      <div class="px-4 pb-10 pt-16 md:px-8 md:pt-20">
        <SectionHeader
          title="The Glyph toolchain"
          description="Everything for holding, sending, and exploring Qubic."
          align="center"
          size="lg"
        />
      </div>

      <ProductGrid products={products} class="px-4 pb-4 md:px-8 md:pb-6" />
    </Reveal>
  </section>

  <PageSection id="everyday">
    <Reveal>
      <div class="grid gap-12 md:grid-cols-[0.92fr_1.08fr] md:gap-16">
        <div>
          <p class="font-display text-[11px] uppercase tracking-[0.16em] text-muted">Everyday Qubic</p>
          <h2 class="mt-4 max-w-[18ch] text-3xl leading-[1.08] tracking-[-0.025em] text-ink md:text-[44px]">
            Built for everyday Qubic.
          </h2>
          <p class="mt-5 max-w-xl text-base leading-7 text-muted md:text-[19px] md:leading-[1.55]">
            A self-custodial desktop wallet for Qubic. Hold Vaults and identities, send QU, and
            approve app requests without handing over your keys.
          </p>
          <ul class="mt-8 space-y-4">
            {
              benefits.map((benefit) => (
                <li class="flex gap-3">
                  <Icon
                    name="solar:check-circle-linear"
                    class="mt-0.5 size-5 shrink-0 text-accent-soft"
                    aria-hidden="true"
                  />
                  <span class="text-base leading-7 text-ink/80">{benefit}</span>
                </li>
              ))
            }
          </ul>
          <div
            class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center"
          >
            <ButtonLink href="/download" variant="primary" icon="glyph">Download Glyph</ButtonLink>
            <ButtonLink
              href={userGuide}
              variant="secondary"
              icon="solar:document-text-linear"
            >
              Read the user guide
            </ButtonLink>
          </div>
          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="https://explorer.glyphq.org" class="text-accent-soft hover:underline">Explorer</a>
            <a href="/support" class="text-accent-soft hover:underline">Support Glyph</a>
            <a href="/about" class="text-accent-soft hover:underline">About Glyph</a>
          </div>
        </div>

        <div class="rounded-2xl bg-surface p-6 md:p-8">
          <p class="font-display text-[11px] uppercase tracking-[0.16em] text-muted">Get started</p>
          <h3 class="mt-3 max-w-[22ch] text-2xl leading-tight tracking-[-0.02em] text-ink md:text-[28px]">
            Three steps to your first transfer.
          </h3>
          <ol class="mt-8 space-y-6">
            {
              steps.map((step, index) => (
                <li class="flex gap-4">
                  <span class="font-mono text-xs text-accent-soft">0{index + 1}</span>
                  <div>
                    <h4 class="text-base font-medium text-ink">{step.title}</h4>
                    <p class="mt-1 text-sm leading-6 text-muted">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="mt-8 text-sm leading-6 text-muted">Windows, macOS, and Linux.</p>
        </div>
      </div>
    </Reveal>
  </PageSection>

  <PageSection id="developers" class="pt-0">
    <Reveal>
      <div
        class="flex flex-col gap-6 rounded-2xl bg-surface p-6 md:flex-row md:items-center md:justify-between md:p-8"
      >
        <div class="max-w-2xl">
          <h2 class="text-2xl leading-tight tracking-[-0.02em] text-ink">Building on Qubic?</h2>
          <p class="mt-2 text-base leading-7 text-muted">
            Add reviewed wallet requests to your app with Glyph Connect and typed Contracts.
          </p>
        </div>
        <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <ButtonLink
            href="https://docs.glyphq.org"
            variant="secondary"
            icon="solar:document-text-linear"
          >
            Read the docs
          </ButtonLink>
          <ButtonLink href="/developers" variant="secondary" icon="solar:code-linear">
            Developer guide
          </ButtonLink>
        </div>
      </div>
    </Reveal>
  </PageSection>
</Layout>
