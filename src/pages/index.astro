---
import ButtonLink from "../components/button-link.astro";
import HeroBackdrop from "../components/hero-backdrop.astro";
import PageSection from "../components/page-section.astro";
import ProductGrid from "../components/product-grid.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { faqs } from "../data/faq";
import { products } from "../data/site";
import Layout from "../layouts/layout.astro";

const userGuide = "https://github.com/glyphq/wallet/blob/main/docs/USER_GUIDE.md";
---

<Layout>
  <section class="relative flex min-h-[75dvh] items-center bg-[#0f0f0f] px-4 py-8 md:px-8">
    <HeroBackdrop />
    <Reveal duration="cinematic" class="relative z-10 w-full py-20 text-center md:py-28">
      <h1 transition:name="page-title" class="flex flex-col items-center">
        <span class="glyph-logo mb-5 block size-10 text-white md:size-12" aria-hidden="true" />
        <span class="flex flex-nowrap items-center justify-center gap-2 md:gap-3">
          <span class="text-[1.875rem] leading-none tracking-[-0.04em] text-white md:text-[88px]">
            Glyph
          </span>
          <span
            class="inline-block rounded-2xl bg-white px-3 py-1 text-[1.875rem] leading-none tracking-[-0.04em] text-night md:rounded-3xl md:px-6 md:py-2 md:text-[88px]"
          >
            Ecosystem
          </span>
        </span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-[620px] text-pretty text-base leading-7 text-white/75 md:text-[19px] md:leading-[1.5]"
      >
        A self-custodial desktop wallet and explorer, with the tools apps use to connect to <img
          src="/brand/qubic-symbol.svg"
          alt=""
          width="31"
          height="52"
          class="mx-1 inline-block h-[1.15em] w-auto align-[-0.16em]"
        /> Qubic.
      </p>
      <div
        class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center"
      >
        <ButtonLink href="/download" variant="light" icon="glyph">Download Glyph</ButtonLink>
        <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="solar:global-linear">
          Explorer
        </ButtonLink>
      </div>
    </Reveal>
  </section>

  <section id="products">
    <Reveal>
      <div class="px-4 pb-10 pt-16 md:px-8 md:pt-20">
        <SectionHeader
          title="The Glyph toolchain"
          description="Everything for holding, sending, and exploring Qubic."
          align="center"
          size="lg"
        />
      </div>

      <ProductGrid products={products} class="px-4 pb-4 md:px-8 md:pb-6" />
    </Reveal>
  </section>

  <PageSection id="faq">
    <Reveal>
      <SectionHeader
        title="Frequently asked questions"
        description="Short answers about Glyph, Vaults, and using Qubic."
        align="center"
        size="lg"
      />

      <div class="mx-auto mt-12 max-w-3xl space-y-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-2xl bg-surface px-5 py-4 md:px-6 md:py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-left [&::-webkit-details-marker]:hidden">
                <span class="text-base font-medium leading-6 text-ink md:text-lg">
                  {faq.question}
                </span>
                <span
                  class="grid size-8 shrink-0 place-items-center rounded-full bg-paper font-mono text-lg text-muted transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-muted md:text-base md:leading-7">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>

      <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-6 text-muted">
        Still need help? Read the <a class="text-accent-soft hover:underline" href={userGuide}>user guide</a> or <a class="text-accent-soft hover:underline" href="/support">contact support</a>.
      </p>
    </Reveal>
  </PageSection>
</Layout>
