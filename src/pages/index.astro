---
import ButtonLink from "../components/button-link.astro";
import HeroBackdrop from "../components/hero-backdrop.astro";
import PageSection from "../components/page-section.astro";
import PrinciplesSplit from "../components/principles-split.astro";
import ProductGrid from "../components/product-grid.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { products, specs } from "../data/site";
import Layout from "../layouts/layout.astro";
---

<Layout>
  <section class="relative flex min-h-[90dvh] items-center bg-[#0f0f0f] px-4 py-8 md:px-8">
    <HeroBackdrop />
    <Reveal duration="cinematic" class="relative z-10 w-full py-20 text-center md:py-28">
      <h1
        transition:name="page-title"
        class="mx-auto max-w-[1080px] text-balance text-[2.75rem] leading-[1.0] tracking-[-0.035em] text-white md:text-[64px]"
      >
        Everything you need for <img
          src="/brand/qubic-symbol.svg"
          alt=""
          width="31"
          height="52"
          class="mx-2 inline-block h-[0.74em] w-auto align-[-0.06em]"
        />Qubic.
      </h1>
      <p
        class="mx-auto mt-6 max-w-[680px] text-pretty text-base leading-7 text-white/75 md:text-[19px] md:leading-[1.5]"
      >
        A self-custodial desktop wallet, an explorer, and the tools apps use to connect.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <ButtonLink href="/download" variant="light" icon="glyph">Download Glyph</ButtonLink>
        <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="solar:global-linear">
          Open Explorer
        </ButtonLink>
      </div>
    </Reveal>
  </section>

  <section id="products">
    <Reveal>
      <div class="px-4 pb-10 pt-16 md:px-8 md:pt-20">
        <SectionHeader
          title="The Glyph toolchain"
          description="Everything for holding, sending, and exploring Qubic."
          align="center"
          size="lg"
        />
      </div>

      <ProductGrid products={products} class="px-4 pb-16 md:px-8 md:pb-20" />
    </Reveal>
  </section>

  <section id="principles" class="px-4 py-20 md:px-8 md:py-28">
    <Reveal>
      <SectionHeader
        title="Built for everyday use"
        description="One wallet for Qubic, with the tools around it."
        align="center"
        size="lg"
      />

      <div class="mt-14">
        <PrinciplesSplit />
      </div>

      <div class="mt-10 flex justify-center">
        <ButtonLink href="/about" variant="secondary" icon="solar:document-text-linear">Read about Glyph</ButtonLink>
      </div>
    </Reveal>
  </section>

  <PageSection id="developers">
    <Reveal>
      <div>
        <div class="grid md:grid-cols-2">
          <div class="p-8 md:p-12">
            <SectionHeader
              title="For developers"
              description="Install the SDKs, read the API, or browse the source."
            />
            <div class="mt-8 flex flex-wrap gap-3">
              <ButtonLink href="https://docs.glyphq.org" icon="solar:document-text-linear">Read the docs</ButtonLink>
              <ButtonLink href="/developers" variant="secondary" icon="solar:code-linear">Developer guide</ButtonLink>
            </div>
          </div>
          <dl>
            {
              specs.map((spec) => (
                <div class="grid grid-cols-[7rem_1fr] gap-4 px-6 py-4 md:px-8">
                  <dt class="font-display text-[11px] uppercase tracking-[0.12em] text-muted">
                    {spec.label}
                  </dt>
                  <dd class="font-sans text-xs text-ink/80">{spec.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </Reveal>
  </PageSection>

</Layout>
