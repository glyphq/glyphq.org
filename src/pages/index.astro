---
import ButtonLink from "../components/button-link.astro";
import CtaSection from "../components/cta-section.astro";
import PageSection from "../components/page-section.astro";
import PatternWaves from "../components/pattern-waves";
import PrinciplesSplit from "../components/principles-split.astro";
import ProductCard from "../components/product-card.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { products, specs } from "../data/site";
import Layout from "../layouts/layout.astro";
---

<Layout>
  <section class="relative overflow-hidden border-b border-line p-8">
    <div class="absolute inset-0 opacity-55">
      <PatternWaves
        client:only="react"
        preset="silk"
        color="#2563eb"
        backgroundColor="#0a0a0a"
        fade="edges"
        speed={0}
        intro={false}
      />
    </div>
    <Reveal duration="cinematic" class="relative z-10 py-16 text-center md:py-24">
      <h1 transition:name="page-title" class="mx-auto max-w-[1080px] text-[2.5rem] leading-[1.02] tracking-[-0.03em] text-ink md:text-[56px]">
        Everything you need for Qubic.
      </h1>
      <p class="mx-auto mt-6 max-w-[680px] text-base leading-7 text-muted md:text-[19px] md:leading-[1.4]">
        A self-custodial desktop wallet, an explorer, and the tools apps use to connect.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <ButtonLink href="/download" variant="light" icon="glyph">Download Glyph</ButtonLink>
        <ButtonLink href="https://explorer.glyphq.org" variant="glass" icon="solar:global-linear">
          Open Explorer
        </ButtonLink>
      </div>
    </Reveal>
  </section>

  <div class="border-b border-line px-4 py-3 text-center text-sm md:px-8">
    <span class="text-muted">New to Qubic? Start with the wallet.</span>
    <a class="ml-2 font-medium text-accent-soft hover:underline" href="/download">Download Glyph</a>
  </div>

  <section id="products" class="border-b border-line">
    <Reveal>
      <div class="px-4 pb-12 pt-20 md:px-8 md:pt-24">
        <SectionHeader
          title="The Glyph toolchain"
          description="Everything for holding, sending, and exploring Qubic."
          align="center"
          size="lg"
        />
      </div>

      <div class="grid divide-y divide-line border-y border-line md:grid-cols-3 md:divide-x md:divide-y-0">
        {products.map((product) => <ProductCard {...product} />)}
      </div>

      <div class="px-4 py-12 md:px-8">
        <div class="flex justify-center">
          <ButtonLink href="/products" variant="secondary" icon="solar:widget-linear">View all products</ButtonLink>
        </div>
      </div>
    </Reveal>
  </section>

  <section id="principles" class="border-b border-line px-4 py-20 md:px-8 md:py-24">
    <Reveal>
      <SectionHeader
        title="Built for everyday use"
        description="One wallet for Qubic, with the tools around it."
        align="center"
        size="lg"
      />

      <div class="mt-14">
        <PrinciplesSplit />
      </div>

      <div class="mt-10 flex justify-center">
        <ButtonLink href="/about" variant="secondary" icon="solar:document-text-linear">Read about Glyph</ButtonLink>
      </div>
    </Reveal>
  </section>

  <PageSection id="developers">
    <Reveal>
      <div class="-mx-4 border-y border-line md:-mx-8">
        <div class="grid md:grid-cols-2 md:divide-x md:divide-line">
          <div class="p-8 md:p-12">
            <SectionHeader
              title="For developers"
              description="Install the SDKs, read the API, or browse the source."
            />
            <div class="mt-8 flex flex-wrap gap-3">
              <ButtonLink href="https://docs.glyphq.org" icon="solar:document-text-linear">Read the docs</ButtonLink>
              <ButtonLink href="/developers" variant="secondary" icon="solar:code-linear">Developer guide</ButtonLink>
            </div>
          </div>
          <dl>
            {
              specs.map((spec) => (
                <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-line px-6 py-4 last:border-b-0 md:px-8">
                  <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                    {spec.label}
                  </dt>
                  <dd class="font-mono text-xs text-ink/80">{spec.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </Reveal>
  </PageSection>

  <CtaSection />
</Layout>
