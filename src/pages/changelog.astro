---
import { SiGithub } from "@icons-pack/react-simple-icons";
import { marked } from "marked";
import ButtonLink from "../components/button-link.astro";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";
import { getReleases, releasesPage } from "../lib/releases";

const releases = await getReleases(8);
const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });
const notes = (body: string) =>
  marked.parse(body || "No notes for this release.", { async: false }) as string;
---

<Layout title="Changelog | Glyph" description="Release notes for Glyph Wallet.">
  <PageHero title="Changelog" description="Release notes for Glyph Wallet." />

  <PageSection>
    <Reveal>
      {
        releases.length > 0 ? (
          <div class="space-y-12">
            {releases.map((release) => (
              <article data-scroll-reveal class="space-y-3">
                <h2 class="text-2xl font-medium tracking-tight text-ink">{release.name}</h2>
                <div class="flex items-center gap-3">
                  <a
                    class="text-muted transition-colors hover:text-ink"
                    href={release.url}
                    aria-label={`View ${release.tag} on GitHub`}
                    title="View on GitHub"
                  >
                    <SiGithub size={16} aria-hidden="true" />
                  </a>
                  <p class="font-mono text-xs text-muted">
                    {dateFormatter.format(new Date(release.publishedAt))}
                  </p>
                </div>
                <div
                  class="max-w-3xl text-base leading-7 text-muted [&_a]:text-accent-soft [&_a]:underline [&_h1]:mt-6 [&_h1]:text-xl [&_h1]:text-ink [&_h2]:mt-6 [&_h2]:text-lg [&_h2]:text-ink [&_h3]:mt-4 [&_h3]:text-base [&_h3]:text-ink [&_li]:ml-5 [&_li]:list-disc [&_p]:mt-3 [&_pre]:mt-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:bg-[#1A1513] [&_pre]:p-4 [&_strong]:text-ink"
                  set:html={notes(release.body)}
                />
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center">
            <p class="text-base text-muted">No releases available right now.</p>
            <div class="mt-6">
              <ButtonLink href={releasesPage} icon="solar:code-linear">
                View releases on GitHub
              </ButtonLink>
            </div>
          </div>
        )
      }
    </Reveal>
  </PageSection>
</Layout>
