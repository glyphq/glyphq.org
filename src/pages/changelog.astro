---
import ButtonLink from "../components/button-link.astro";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import ReleaseThumbnail from "../components/release-thumbnail.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";
import { getChangelogReleases, releasesPage } from "../lib/releases";

const releases = await getChangelogReleases(8);
const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });

const excerpt = (body: string) => {
  const text = body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/`[^`]+`/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_~-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  if (!text) return "No notes for this release.";
  return text.length > 140 ? `${text.slice(0, 140).trimEnd()}...` : text;
};
---

<Layout title="Changelog | Glyph" description="Release notes for Glyph Wallet.">
  <PageHero variant="article" title="Changelog" description="Release notes for Glyph Wallet." />

  <PageSection>
    <Reveal>
      {
        releases.length > 0 ? (
          <div class="mx-auto max-w-6xl">
          <div class="grid max-w-3xl gap-5 sm:grid-cols-2">
            {releases.map((release) => (
              <a
                href={`/changelog/${release.tag}`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl bg-surface transition-colors duration-150 hover:bg-[#2A1F21]"
              >
                <ReleaseThumbnail tag={release.tag} class="rounded-none" />
                <div class="flex flex-1 flex-col p-5">
                  <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                    <time datetime={release.publishedAt}>
                      {dateFormatter.format(new Date(release.publishedAt))}
                    </time>
                  </p>
                  <h2 class="mt-3 text-xl font-medium tracking-tight text-ink">
                    {release.name}
                  </h2>
                  <p class="mt-2 line-clamp-3 text-sm leading-6 text-muted">
                    {excerpt(release.body)}
                  </p>
                  <span class="mt-auto pt-5 text-sm font-medium text-accent-soft">
                    Read release notes
                  </span>
                </div>
              </a>
            ))}
          </div>
          </div>
        ) : (
          <div class="text-center">
            <p class="text-base text-muted">No releases available right now.</p>
            <div class="mt-6">
              <ButtonLink href={releasesPage} icon="solar:code-linear">
                View releases on GitHub
              </ButtonLink>
            </div>
          </div>
        )
      }
    </Reveal>
  </PageSection>
</Layout>
