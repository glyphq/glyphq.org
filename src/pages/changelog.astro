---
import ButtonLink from "../components/button-link.astro";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";
import { getChangelogReleases, releasesPage } from "../lib/releases";

export const prerender = false;

const releases = await getChangelogReleases(8);
const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });

const excerpt = (body: string) => {
  const text = body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/`[^`]+`/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_~-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  if (!text) return "No notes for this release.";
  return text.length > 140 ? `${text.slice(0, 140).trimEnd()}...` : text;
};
---

<Layout title="Changelog | Glyph" description="Release notes for Glyph Wallet.">
  <PageHero variant="article" title="Changelog" description="Release notes for Glyph Wallet." />

  <PageSection spacing="compact">
    <Reveal>
      {
        releases.length > 0 ? (
          <div class="-mx-4 divide-y divide-line border-y border-line md:-mx-8">
            {releases.map((release) => (
              <a
                href={`/changelog/${release.tag}`}
                class="group grid gap-5 px-4 py-7 transition-colors duration-150 hover:bg-surface/60 md:grid-cols-[minmax(0,1fr)_10rem] md:items-start md:gap-8 md:px-8 md:py-8"
              >
                <div class="min-w-0">
                  <h2 class="text-xl font-medium tracking-tight text-ink md:text-2xl">
                    {release.name}
                  </h2>
                  <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-6 text-muted">
                    {excerpt(release.body)}
                  </p>
                </div>
                <div class="flex items-center gap-3 font-mono md:flex-col md:items-end md:gap-1.5 md:text-right">
                  <time
                    datetime={release.publishedAt}
                    class="text-[10px] tracking-[0.04em] text-faint"
                  >
                    {dateFormatter.format(new Date(release.publishedAt))}
                  </time>
                  <span class="text-[12px] text-ink/60">{release.tag}</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center">
            <p class="text-base text-muted">No releases available right now.</p>
            <div class="mt-6">
              <ButtonLink href={releasesPage} icon="code">
                View releases on GitHub
              </ButtonLink>
            </div>
          </div>
        )
      }
    </Reveal>
  </PageSection>
</Layout>
