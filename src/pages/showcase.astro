---
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import ProjectCard from "../components/project-card.astro";
import Reveal from "../components/reveal.astro";
import { showcaseProducts } from "../data/showcase";
import Layout from "../layouts/layout.astro";

export const prerender = true;

const discord = "https://discord.gg/faKATpcHGf";
---

<Layout title="Showcase | Glyph" description="Apps using Glyph Wallet and the Glyph toolchain.">
  <PageHero
    variant="article"
    title="Showcase"
    description="Apps using Glyph Wallet and the Glyph toolchain."
  />

  <PageSection spacing="compact">
    <Reveal>
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto grid max-w-3xl gap-4 md:grid-cols-2">
        {showcaseProducts.map((post) => <ProjectCard {...post} />)}
      </div>

        <p class="mx-auto mt-10 max-w-2xl text-center text-sm leading-6 text-muted">
          Built something with Glyph? <a class="text-accent-soft hover:underline" href={discord}>Share it in Discord</a>.
        </p>
      </div>
    </Reveal>
  </PageSection>
</Layout>
