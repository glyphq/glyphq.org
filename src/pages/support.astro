---
import moment from "moment";
import DonateModal from "../components/donate-modal.astro";
import DonationDonors from "../components/donation-donors";
import DonationProgress from "../components/donation-progress";
import PageHero from "../components/page-hero.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";

const qubicIdentity = "LOGCQXSJIQFNNFHFBADRFLVNNXGBVKZGJXOPZSHTQDKNRIIFWXXPYVUCUSTD";
const minerLabLast = moment().subtract(4, "months").fromNow();
let profiles: { identity: string; displayName: string }[] = [];
try {
  const response = await fetch("https://explorer.glyphq.org/api/profiles/known");
  if (response.ok) {
    const payload = (await response.json()) as {
      profiles?: { identity: string; displayName: string }[];
    };
    profiles = payload.profiles ?? [];
  }
} catch {
  profiles = [];
}
---

<Layout
  title="Support | Glyph"
  description="Support Glyph with QU and follow the current development window."
>
  <PageHero
    variant="article"
    title="Support Glyph"
    description="A small team maintains Glyph. Donations fund development and infrastructure."
  >
    <div class="flex w-full flex-col items-start gap-4">
      <DonationProgress client:load identity={qubicIdentity} target={2000} />
      <DonateModal identity={qubicIdentity} />
    </div>
  </PageHero>


  <section class="bg-paper px-4 pb-20 pt-10 md:px-8 md:pb-28 md:pt-12">
    <Reveal>
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-medium tracking-tight text-ink md:text-4xl">Supporters</h2>
          <p class="mt-4 text-base leading-7 text-muted md:text-lg md:leading-8">
            Projects and identities backing Glyph.
          </p>
        </div>
        <div class="mt-6 w-full">
          <DonationDonors
            client:load
            identity={qubicIdentity}
            profiles={profiles}
            staticSupporter={{
              amount: "$2,000+",
              ariaLabel: "MinerLab donated $2,000 or more",
              href: "https://minerlab.io",
              label: "minerlab.io",
              timestamp: minerLabLast,
            }}
          />
        </div>
      </div>
    </Reveal>
  </section>

</Layout>
