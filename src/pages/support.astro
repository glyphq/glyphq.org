---
import ButtonLink from "../components/button-link.astro";
import CopyButton from "../components/copy-button";
import DonationProgress from "../components/donation-progress";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import Layout from "../layouts/layout.astro";

const qubicIdentity = "XIKAQZMFGQSALEMMJRATPPRESWTBXQVCOHTHCZWDGFXVBMCAHBCRUICFOQBI";
---

<Layout
  title="Support | Glyph"
  description="Support Glyph with QU and follow the live donation balance toward the monthly target."
>
  <PageHero
    title="Support Glyph"
    description="Glyph is built by a small team. Donations fund development and infrastructure."
  >
    <ButtonLink href="#donate" variant="light" icon="solar:hand-heart-linear">
      Donate QU
    </ButtonLink>
    <ButtonLink
      href={`https://explorer.glyphq.org/accounts/${qubicIdentity}`}
      variant="glass"
      icon="solar:global-linear"
    >
      View on Explorer
    </ButtonLink>
  </PageHero>

  <PageSection id="donate" class="pb-10 md:pb-12">
      <SectionHeader
        title="Monthly target"
        description="Help Glyph reach $2,000 every month. Progress is read live from the Qubic donation identity."
        align="center"
        size="lg"
      />
      <DonationProgress client:load identity={qubicIdentity} target={2000} />

      <div class="mt-12">
        <div>
          <h2 class="text-2xl font-medium tracking-tight text-ink">Donate QU</h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-muted">
            Send QU on Qubic mainnet to this identity. Copy it or open it in Glyph Wallet.
          </p>
          <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <code class="select-all break-all font-mono text-xs leading-5 text-ink/80">
              {qubicIdentity}
            </code>
            <CopyButton value={qubicIdentity} label="Qubic" client:load />
          </div>
        </div>
      </div>
  </PageSection>

  <PageSection>
    <Reveal>
      <SectionHeader
        title="Supporters"
        description="Projects and people who have backed Glyph."
        align="center"
        size="lg"
      />
      <div class="mt-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-4">
            <img
              src="/sponsors/minerlab.png"
              alt="MinerLab"
              width="96"
              height="31"
              class="sponsor-logo h-8 w-auto"
            />
            <div>
              <p class="text-sm text-muted">$2,000+ donated</p>
            </div>
          </div>
          <ButtonLink href="https://minerlab.io" variant="secondary" icon="solar:global-linear">
            Visit MinerLab
          </ButtonLink>
        </div>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
          MinerLab runs mining pools for Qubic, Xelis, Abel, and Ore, with transparent payouts and
          live network stats.
        </p>
      </div>
    </Reveal>
  </PageSection>
</Layout>
