---
import ButtonLink from "../components/button-link.astro";
import DonateModal from "../components/donate-modal.astro";
import DonationProgress from "../components/donation-progress";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";

const qubicIdentity = "XIKAQZMFGQSALEMMJRATPPRESWTBXQVCOHTHCZWDGFXVBMCAHBCRUICFOQBI";
---

<Layout
  title="Support | Glyph"
  description="Support Glyph with QU and follow the current development window."
>
  <PageHero
    variant="article"
    title="Support Glyph"
    description="A small team maintains Glyph. Donations fund development and infrastructure."
  >
    <div class="flex w-full max-w-3xl flex-col items-start gap-4">
      <DonationProgress client:load identity={qubicIdentity} target={2000} />
      <DonateModal identity={qubicIdentity} />
    </div>
  </PageHero>

  <PageSection>
    <Reveal>
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-medium tracking-tight text-ink">What it funds</h2>
          <p class="mt-4 text-base leading-7 text-muted">
            Donations fund development, infrastructure, and releases. The dialog has the Qubic
            identity and a direct link to the Explorer.
          </p>
        </div>
      </div>
    </Reveal>
  </PageSection>

  <PageSection>
    <Reveal>
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-medium tracking-tight text-ink">Supporters</h2>
          <div class="mt-6 rounded-2xl bg-surface p-5 md:p-6">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <img
                src="/sponsors/minerlab.png"
                alt="MinerLab"
                width="96"
                height="31"
                class="sponsor-logo h-8 w-auto"
              />
              <p class="text-sm text-muted">$2,000+ donated</p>
            </div>
            <ButtonLink
              href="https://minerlab.io"
              variant="secondary"
              icon="solar:global-linear"
              class="w-fit"
            >
              Visit MinerLab
            </ButtonLink>
          </div>
            <p class="mt-4 text-sm leading-6 text-muted md:text-base md:leading-7">
              MinerLab runs mining pools for Qubic, Xelis, Abel, and Ore, with transparent payouts and
              live network stats.
            </p>
          </div>
        </div>
      </div>
    </Reveal>
  </PageSection>
</Layout>
