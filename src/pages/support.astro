---
import ButtonLink from "../components/button-link.astro";
import CopyButton from "../components/copy-button";
import DonationProgress from "../components/donation-progress";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import Layout from "../layouts/layout.astro";

const qubicIdentity = "XIKAQZMFGQSALEMMJRATPPRESWTBXQVCOHTHCZWDGFXVBMCAHBCRUICFOQBI";
---

<Layout
  title="Support | Glyph"
  description="Support Glyph with QU and follow the current development window from the Qubic donation identity."
>
  <PageHero
    variant="article"
    title="Support Glyph"
    description="Glyph is maintained by a small team. Donations pay for development and infrastructure."
  />

  <PageSection id="donate">
    <Reveal>
      <div class="mx-auto max-w-6xl">
      <div class="grid max-w-3xl gap-8 md:grid-cols-[1.05fr_0.95fr] md:gap-12">
        <div>
          <p class="font-display text-[11px] uppercase tracking-[0.16em] text-muted">
            Development window
          </p>
          <h2 class="mt-4 max-w-[16ch] text-3xl leading-[1.08] tracking-[-0.025em] text-ink md:text-[44px]">
            Fund the next development window.
          </h2>
          <p class="mt-5 max-w-xl text-base leading-7 text-muted md:text-[19px] md:leading-[1.55]">
            The current window pays for development and infrastructure. The bar shows the USD value
            of incoming QU at the current price.
          </p>

          <div data-scroll-reveal class="mt-8 rounded-2xl bg-surface p-5 md:p-6">
            <p class="text-sm text-muted">Send QU on Qubic mainnet</p>
            <code class="mt-3 block select-all break-all font-mono text-xs leading-5 text-ink/80">
              {qubicIdentity}
            </code>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <CopyButton value={qubicIdentity} label="Qubic identity" client:load />
              <a
                href={`https://explorer.glyphq.org/accounts/${qubicIdentity}`}
                class="text-sm text-accent-soft hover:underline"
              >
                View on Explorer
              </a>
            </div>
          </div>
        </div>

        <div data-scroll-reveal class="rounded-2xl bg-surface p-5 md:p-6">
          <DonationProgress client:load identity={qubicIdentity} target={2000} />
        </div>
      </div>
      </div>
    </Reveal>
  </PageSection>

  <PageSection>
    <Reveal>
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          title="Supporters"
          description="Projects and people who have backed Glyph."
          align="center"
          size="lg"
        />

        <div class="mt-12 max-w-3xl">
        <div data-scroll-reveal class="rounded-2xl bg-surface p-5 md:p-6">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <img
                src="/sponsors/minerlab.png"
                alt="MinerLab"
                width="96"
                height="31"
                class="sponsor-logo h-8 w-auto"
              />
              <div>
                <p class="text-sm text-muted">$2,000+ donated</p>
              </div>
            </div>
            <ButtonLink
              href="https://minerlab.io"
              variant="secondary"
              icon="solar:global-linear"
              class="w-fit"
            >
              Visit MinerLab
            </ButtonLink>
          </div>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-muted md:text-base md:leading-7">
            MinerLab runs mining pools for Qubic, Xelis, Abel, and Ore, with transparent payouts and
            live network stats.
          </p>
        </div>
        </div>
      </div>
    </Reveal>
  </PageSection>
</Layout>
