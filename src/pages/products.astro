---
import PageHero from "../components/page-hero.astro";
import PrinciplesRow from "../components/principles-row.astro";
import ProductGrid from "../components/product-grid.astro";
import Reveal from "../components/reveal.astro";
import SectionHeader from "../components/section-header.astro";
import { products } from "../data/site";
import Layout from "../layouts/layout.astro";
---

<Layout
  title="Products | Glyph"
  description="The Glyph toolchain for Qubic: wallet, Connect SDK, typed contracts, relay, explorer, and self-hosted API."
>
  <PageHero
    title="The Glyph toolchain"
    description="Wallet, explorer, and developer tools for Qubic."
  />

  <section>
    <Reveal>
      <div class="px-4 pb-10 pt-16 md:px-8 md:pt-20">
        <SectionHeader
          title="Every product in one place"
          description="Use one part or the whole stack. Each product links to its docs or source."
          align="center"
          size="lg"
        />
      </div>
      <ProductGrid products={products} class="px-4 md:px-8" />
      <div class="px-4 py-12 md:px-8">
        <PrinciplesRow />
      </div>
    </Reveal>
  </section>

</Layout>
