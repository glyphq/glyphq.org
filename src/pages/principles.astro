---
import ButtonLink from "../components/button-link.astro";
import CtaSection from "../components/cta-section.astro";
import PageHero from "../components/page-hero.astro";
import PageSection from "../components/page-section.astro";
import PrinciplesSplit from "../components/principles-split.astro";
import Reveal from "../components/reveal.astro";
import Layout from "../layouts/layout.astro";
---

<Layout
  title="Principles | Glyph"
  description="Glyph is self-custodial and built for everyday Qubic use."
>
  <PageHero
    title="How Glyph works"
    description="A wallet for people and the tools around it."
  >
    <ButtonLink href="/products" variant="light" icon="solar:layers-linear">Explore the products</ButtonLink>
    <ButtonLink href="/about" variant="glass" icon="solar:document-text-linear">About Glyph</ButtonLink>
  </PageHero>

  <PageSection>
    <Reveal>
      <PrinciplesSplit />
    </Reveal>
  </PageSection>

  <CtaSection />
</Layout>
